# Copy to .env. Without a key, Sanad runs fully offline (hash embeddings + mock LLM).
GEMINI_API_KEY=

# Optional overrides
# SANAD_LLM_MODEL=gemini-3.5-flash-lite   # or gemini-3.8-flash for the strongest Flash model
# SANAD_EMBED_MODEL=gemini-embedding-001
# SANAD_EMBED_DIM=768
# SANAD_CORPUS_DIR=data/demo
# SANAD_INDEX_DIR=.index
# SANAD_RETRIEVAL_MODE=graph   # bm25 | dense | hybrid | graph
